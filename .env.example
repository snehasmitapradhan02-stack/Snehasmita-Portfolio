# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you actually want to use.
# Every value is optional — the site works (gracefully) without any of them.
# ---------------------------------------------------------------------------

# Public contact details.
# NOTE: these fall back to the values written in src/data/contact.js.
# Social URLs live in ONE place: `socialLinks` in src/data/contact.js.
# Set a variable here only to override that value.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles. Leave empty to use the defaults in src/data/contact.js.
# TODO: set NEXT_PUBLIC_GITHUB_URL to the real profile once it exists —
# the default is the generic `https://github.com/` placeholder.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Canonical site origin, e.g. https://your-domain.com
# Used for absolute URLs in metadata (canonical link, Open Graph images).
# Left empty on purpose: until a real domain exists nothing is advertised
# that the owner does not own.
NEXT_PUBLIC_SITE_URL=

# Optional: link to the PDF resume you drop in /public/resume/
NEXT_PUBLIC_RESUME_FILE=/resume/Snehasmita-Pradhan-Resume.pdf

# ---------------------------------------------------------------------------
# EmailJS (optional).
# While these are empty the contact form shows
# "Email service is not configured yet." and offers a WhatsApp / mailto fallback.
# NEVER commit real EmailJS secrets to a public repository.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
